#!/usr/bin/env bash
# tds — HPDF TDS document converter
#
# Wraps tds_render.py and tds_unconvert.py inside a Docker container,
# volume-mounting the current directory so all relative file paths
# (diagrams/, .mmd sidecars, referenced PNGs) work exactly as they do
# when running the scripts locally.
#
# INSTALLATION
#   Copy this file to a directory on your PATH and make it executable:
#     cp tds /usr/local/bin/tds && chmod +x /usr/local/bin/tds
#   Or just run it in-place:
#     chmod +x tds && ./tds help
#
# REQUIREMENTS
#   Docker Desktop, Colima, or any Docker-compatible runtime.
#   No other local dependencies needed — everything else is in the image.
#
# USAGE
#   cd /path/to/your/tds/working/directory
#   tds validate HPDF_TDS_0001_example.md
#   tds render   HPDF_TDS_0001_example.md
#   tds unrender HPDF_TDS_0001_example.docx

set -euo pipefail

IMAGE="${TDS_IMAGE:-ibaldin/tds:latest}"
COMMAND="${1:-help}"

# ── Helpers ────────────────────────────────────────────────────────────────────

_check_docker() {
    if ! command -v docker &>/dev/null; then
        echo "Error: Docker is not installed or not on PATH." >&2
        echo "Install Docker Desktop: https://www.docker.com/products/docker-desktop/" >&2
        exit 1
    fi
    if ! docker info &>/dev/null 2>&1; then
        echo "Error: Docker daemon is not running." >&2
        echo "Start Docker Desktop (or Colima) and try again." >&2
        exit 1
    fi
}

_ensure_image() {
    if ! docker image inspect "$IMAGE" &>/dev/null 2>&1; then
        echo "Image '$IMAGE' not found locally — pulling from Docker Hub ..."
        docker pull "$IMAGE"
    fi
}

_run() {
    # --rm           : remove the container after it exits
    # --user         : run as the calling user so output files are not owned by root
    # -e HOME=/tmp   : give Chromium/Puppeteer a writable home dir inside the container
    # -v $(pwd):/workspace : mount the current directory as the working directory
    # -w /workspace  : set container CWD to the mount point
    docker run --rm \
        --user "$(id -u):$(id -g)" \
        -e HOME=/tmp \
        -v "$(pwd):/workspace" \
        -w /workspace \
        "$IMAGE" \
        "$@"
}

# ── Commands ───────────────────────────────────────────────────────────────────

case "$COMMAND" in

    new)
        # Create a new TDS document from the template and register it.
        # Usage: tds new <title> [--owner <name>] [--component <name>]
        #                        [--id <NNNN>] [--slug <slug>]
        _check_docker
        _ensure_image
        shift
        _run python3 /app/scripts/tds_new.py "$@"
        ;;

    validate)
        # Validate a TDS Markdown file before rendering.
        # Runs all registered checks (Mermaid syntax, image references, …) and
        # exits 0 if everything passes, 1 if any check fails.
        # Usage: tds validate <file.md> [--check mermaid,images]
        #
        # tds_validate.py is resolved in this order:
        #   1. $TDS_SCRIPTS_DIR/tds_validate.py  (explicit env var override)
        #   2. scripts/ sibling to this script    (source checkout, no image rebuild needed)
        #   3. /app/scripts/tds_validate.py       (baked into the Docker image after rebuild)
        _check_docker
        _ensure_image
        shift

        _VALIDATE_SCRIPT=""
        if [[ -n "${TDS_SCRIPTS_DIR:-}" && -f "$TDS_SCRIPTS_DIR/tds_validate.py" ]]; then
            _VALIDATE_SCRIPT="$TDS_SCRIPTS_DIR/tds_validate.py"
        else
            _SIBLING_SCRIPT="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/scripts/tds_validate.py"
            if [[ -f "$_SIBLING_SCRIPT" ]]; then
                _VALIDATE_SCRIPT="$_SIBLING_SCRIPT"
            fi
        fi

        if [[ -n "$_VALIDATE_SCRIPT" ]]; then
            # Mount only the single script file so we don't shadow the rest of /app/scripts
            docker run --rm \
                --user "$(id -u):$(id -g)" \
                -e HOME=/tmp \
                -v "$(pwd):/workspace" \
                -v "$_VALIDATE_SCRIPT:/app/scripts/tds_validate.py:ro" \
                -w /workspace \
                "$IMAGE" \
                python3 /app/scripts/tds_validate.py "$@"
        else
            # Fall back to the version baked into the image (after a rebuild)
            _run python3 /app/scripts/tds_validate.py "$@"
        fi
        ;;

    render)
        # Convert a TDS Markdown file to a styled DOCX with cover page.
        # All options are passed through to tds_render.py.
        _check_docker
        _ensure_image
        shift
        _run python3 /app/scripts/tds_render.py "$@"
        ;;

    unrender)
        # Convert a reviewed DOCX back to Markdown, restoring Mermaid blocks
        # and YAML frontmatter from the original .md in the same directory.
        # All options are passed through to tds_unconvert.py.
        _check_docker
        _ensure_image
        shift
        _run python3 /app/scripts/tds_unconvert.py "$@"
        ;;

    pull)
        # Pull (or update) the Docker image from Docker Hub.
        _check_docker
        docker pull --platform linux/amd64 "$IMAGE"
        ;;

    init)
        # Initialise the current directory as a TDS working repository.
        # Does NOT require Docker — uses only curl and standard shell tools.
        REPO_ROOT="https://raw.githubusercontent.com/ibaldin/tds/main"
        INIT_FILES=("TDS_REGISTRY.md" "TDS_TEMPLATE.md" "TDS_WORKFLOW.md" "HPDF_TDS_0001_example.md")

        echo "This will initialise the following directory as a TDS repository:"
        echo ""
        echo "  $(pwd)"
        echo ""
        printf "Continue? [y/N] "
        read -r _answer </dev/tty
        case "$_answer" in
            [yY]|[yY][eE][sS]) ;;
            *) echo "Aborted."; exit 0 ;;
        esac

        # Create diagrams/ subdirectory (idempotent)
        mkdir -p diagrams
        echo "  ✓ diagrams/ ready"

        # Download template files from the GitHub repo
        if ! command -v curl &>/dev/null; then
            echo "Error: curl is required for 'tds init' but was not found on PATH." >&2
            exit 1
        fi

        echo ""
        for _f in "${INIT_FILES[@]}"; do
            if [[ -e "$_f" ]]; then
                echo "  • $_f already exists — skipping (delete it first to re-download)"
            else
                printf "  Downloading %-24s" "$_f ..."
                if curl -fsSL "$REPO_ROOT/$_f" -o "$_f"; then
                    echo " done"
                else
                    echo " FAILED" >&2
                    echo "Error: could not download $_f from $REPO_ROOT" >&2
                    exit 1
                fi
            fi
        done

        echo ""
        echo "Repository ready. Suggested next steps:"
        echo "  1. tds pull                                       # download the Docker image"
        echo "  2. tds new \"My Component\" --owner \"Name, Site\"    # create your first TDS"
        echo "  3. tds render <generated-file.md>                 # render to DOCX when ready"
        ;;

    help|--help|-h|"")
        cat <<'EOF'
tds — HPDF TDS document converter

USAGE
  tds init                             Initialise current directory as a TDS repo
  tds new      <title>     [options]   Create a new TDS document from the template
  tds validate <file.md>   [options]   Validate Mermaid blocks and image refs
  tds render   <file.md>   [options]   Convert Markdown → DOCX
  tds unrender <file.docx> [options]   Convert reviewed DOCX → Markdown
  tds pull                             Pull / update the Docker image
  tds help                             Show this message

GETTING STARTED
  mkdir my-tds && cd my-tds
  tds init          # downloads templates and creates diagrams/
  tds pull          # pulls the Docker image (one-time)
  tds new "My Component Design" --owner "J. Doe" --component "Storage"

REQUIREMENTS
  Docker Desktop, Colima, or any Docker-compatible runtime.
  Run `tds pull` once to download the image before first use.
  `tds init` only requires curl — no Docker needed.

HOW IT WORKS
  Run tds from your TDS working directory. The current directory is
  volume-mounted into the container at /workspace, so all relative paths
  resolve naturally — diagrams/, .mmd sidecars, referenced PNGs, and the
  output DOCX or MD file all appear alongside your source files as expected.

EXAMPLES
  cd ~/hpdf/tds-docs

  # Create a new TDS (auto-assigns next ID, derives slug from title):
  tds new "Transfer Engine Design" --owner "I. Baldin" --component "Data Transfer"

  # Override the ID or slug if needed:
  tds new "Auth Service" --id 0007 --slug "auth-service" --owner "J. Doe"

  # Validate Mermaid blocks and image refs before rendering:
  tds validate HPDF_TDS_0002_transfer-engine-design.md

  # Run only the Mermaid check:
  tds validate HPDF_TDS_0002_transfer-engine-design.md --check mermaid

  # Render and unrender:
  tds render HPDF_TDS_0002_transfer-engine-design.md
  tds unrender HPDF_TDS_0002_transfer-engine-design.docx

  # Unrender when the original .md has a different stem than the DOCX:
  tds unrender reviewed_copy.docx --original HPDF_TDS_0001_example.md

  # Render without the cover page (faster, good for quick review):
  tds render HPDF_TDS_0001_example.md --no-cover

  # See all options for each subcommand:
  tds new --help
  tds render --help
  tds unrender --help

CONFIGURATION
  Override the Docker image with the TDS_IMAGE environment variable:
    TDS_IMAGE=hpdf/tds-tools:1.0 tds render HPDF_TDS_0001_example.md

  Point 'tds validate' at a local scripts directory (useful before rebuilding
  the Docker image — tds_validate.py is injected into the container at runtime):
    TDS_SCRIPTS_DIR=/path/to/tds/scripts tds validate HPDF_TDS_0001_example.md
  When running tds from a source checkout, scripts/ is detected automatically.

EOF
        ;;

    *)
        echo "Error: unknown command '$COMMAND'" >&2
        echo "Run 'tds help' for usage." >&2
        exit 1
        ;;

esac
